        -- identifiers
        external_ref                                     as external_ref,
        status::boolean                                  as is_active,
        source                                           as payment_source,
        (upper(trim(chargeback)) = 'TRUE')::boolean       as has_chargeback
    from source
)

select * from renamed
  )
