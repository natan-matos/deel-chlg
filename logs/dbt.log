        column_name as "column_name",
        ordinal_position as "column_index",
        data_type as "column_type",
        comment as "column_comment"
    from DEEL.INFORMATION_SCHEMA.columns
            where (
                (
                    
    "table_schema" ilike 'analytics' and upper("table_schema") = upper('analytics')

                    and 
    "table_name" ilike 'fct_globepay__transactions' and upper("table_name") = upper('fct_globepay__transactions')

                )
             or 
                (
                    
    "table_schema" ilike 'RAW' and upper("table_schema") = upper('RAW')

                    and 
    "table_name" ilike 'globepay_acceptance' and upper("table_name") = upper('globepay_acceptance')

                )
             or 
                (
                    
    "table_schema" ilike 'staging' and upper("table_schema") = upper('staging')

                    and 
    "table_name" ilike 'stg_globepay__acceptance' and upper("table_name") = upper('stg_globepay__acceptance')

                )
             or 
                (
                    
    "table_schema" ilike 'analytics' and upper("table_schema") = upper('analytics')

                    and 
    "table_name" ilike 'agg_globepay__acceptance_by_month' and upper("table_name") = upper('agg_globepay__acceptance_by_month')

                )
             or 
                (
                    
    "table_schema" ilike 'staging' and upper("table_schema") = upper('staging')

                    and 
    "table_name" ilike 'stg_globepay__chargeback' and upper("table_name") = upper('stg_globepay__chargeback')

                )
             or 
                (
                    
    "table_schema" ilike 'RAW' and upper("table_schema") = upper('RAW')

                    and 
    "table_name" ilike 'globepay_chargeback' and upper("table_name") = upper('globepay_chargeback')

                )
             or 
                (
                    
    "table_schema" ilike 'analytics' and upper("table_schema") = upper('analytics')

                    and 
    "table_name" ilike 'agg_globepay__declined_by_country' and upper("table_name") = upper('agg_globepay__declined_by_country')

                )
             or 
                (
                    
    "table_schema" ilike 'analytics' and upper("table_schema") = upper('analytics')

                    and 
    "table_name" ilike 'fct_globepay__missing_chargebacks' and upper("table_name") = upper('fct_globepay__missing_chargebacks')

                )
            )
        )
        select *
    from tables
    join columns using ("table_database", "table_schema", "table_name")
    order by "column_index"
